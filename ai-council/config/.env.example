# 복사: cp config/.env.example config/.env
# config/.env 는 커밋하지 말 것

LOCAL_OLLAMA_URL=http://127.0.0.1:11434
LOCAL_CHAT_MODEL=qwen3.6:35b
# --council 시 두 번째 로컬 모델
LOCAL_ALT_MODEL=qwen3:32b

# 외부 호출은 CLI --external 이 있을 때만. 키 없으면 안전하게 실패.
# 마우스: scripts/키넣기.command 더블클릭 → TextEdit에서 키만 채우기
EXTERNAL_AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
